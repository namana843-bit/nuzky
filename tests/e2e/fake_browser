#!/usr/bin/env python3
"""Follow the sign-in redirect without opening a window, and keep the callback page."""
import os, sys, urllib.request
from pathlib import Path

page = Path(os.environ['NUZKY_FAKE_BROWSER_PAGE'])
with urllib.request.urlopen(sys.argv[1], timeout=20) as response:
    body = response.read().decode('utf-8')
temporary = page.with_suffix('.tmp')
temporary.write_text(body)
temporary.replace(page)
